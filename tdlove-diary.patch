+
+  useEffect(() => { sign(old.map((m: any) => m.thumb_path ?? m.path)).then(setOldUrl) }, [old])
+  useEffect(() => () => { itemsRef.current.forEach(i => URL.revokeObjectURL(i.url)) }, [])
+  useEffect(() => {   // đang tải ảnh lên thì cảnh báo khi người dùng định rời trang
