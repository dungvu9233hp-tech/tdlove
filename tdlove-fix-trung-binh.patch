+++ b/supabase/phase20.sql
@@ -0,0 +1,39 @@
+-- Giai đoạn 20: vá lỗi mức trung bình T4 và T9 (báo cáo rà soát 07/11/2026).
+-- Chạy SAU phase19.sql. Có thể chạy lại an toàn.
+
+-- T4: chỉ còn sửa được tên và ngày bắt đầu yêu của Space (trước đây mọi thành viên sửa được mọi cột,
+-- kể cả invite_code/invite_expires). Các hàm security definer (renew_invite, join_space) vẫn ghi bình thường.
+revoke update on spaces from authenticated, anon;
+grant update (name, start_date) on spaces to authenticated;
+drop policy if exists sp_u on spaces;
+create policy sp_u on spaces for update using (id = my_space()) with check (id = my_space());
+
+-- T4: ngày bắt đầu yêu phải từ 01/01/1950 đến hôm nay (giờ Việt Nam, chừa 1 ngày lệch múi giờ máy).
+-- Ngày quá cũ làm điểm cấp độ (level_stats) phình ra hàng trăm nghìn; ngày tương lai làm số ngày âm.
+-- Dùng trigger (không dùng CHECK vì now() không bất biến); chỉ kiểm khi giá trị thay đổi nên dữ liệu cũ không bị chặn.
+create or replace function spaces_check_start_date() returns trigger language plpgsql as $$
+begin
+  if new.start_date is not null
+     and (tg_op = 'INSERT' or new.start_date is distinct from old.start_date)
+     and (new.start_date < date '1950-01-01'
+          or new.start_date > (now() at time zone 'Asia/Ho_Chi_Minh')::date + 1) then
+    raise exception 'Ngày bắt đầu yêu phải từ 01/01/1950 đến hôm nay';
+  end if;
+  return new;
+end $$;
+drop trigger if exists spaces_start_date_chk on spaces;
+create trigger spaces_start_date_chk before insert or update on spaces
+  for each row execute function spaces_check_start_date();
+
+-- T9: create_space không được gọi khi đã ở trong một Space (trước đây gọi lại là rời Space cũ và bỏ lại một người).
+create or replace function create_space(p_name text) returns text language plpgsql security definer set search_path = public as $$
+declare s spaces; begin
+  if auth.uid() is null then raise exception 'Bạn cần đăng nhập'; end if;
+  if exists (select 1 from profiles where id = auth.uid() and space_id is not null) then
+    raise exception 'Bạn đã ở trong một Space rồi'; end if;
+  insert into spaces default values returning * into s;
+  insert into profiles(id, space_id, display_name) values (auth.uid(), s.id, p_name)
+    on conflict (id) do update set space_id = s.id, display_name = p_name;
+  return s.invite_code; end $$;
+revoke all on function create_space(text) from public, anon;
+grant execute on function create_space(text) to authenticated;
diff --git a/supabase/phase21.sql b/supabase/phase21.sql
new file mode 100644
index 0000000..d559f50
--- /dev/null
+++ b/supabase/phase21.sql
@@ -0,0 +1,47 @@
+-- Giai đoạn 21: sửa lỗi T7 - gọi khi app bên nhận đang đóng (CALL-05).
+-- Chạy SAU phase20.sql. Có thể chạy lại an toàn.
+--
+-- Nguyên nhân: lời mời gọi chỉ đi qua kênh broadcast (không lưu lại). Bên nhận đóng app nhận được thông báo đẩy,
+-- nhưng mở app thì lời mời đã mất nên cuộc gọi không bao giờ kết nối.
+-- Cách sửa: người gọi ghi một dòng vào bảng calls (trạng thái 'ringing'); app bên nhận hỏi hàm ringing_call()
+-- khi mở app / quay lại app. Hàm tính theo giờ server nên không lệch đồng hồ máy. Tín hiệu WebRTC vẫn đi qua broadcast.
+
+create table if not exists calls(
+  id uuid primary key default gen_random_uuid(),
+  space_id uuid not null default my_space(),
+  caller uuid not null default auth.uid(),
+  video boolean not null default false,
+  status text not null default 'ringing' check (status in ('ringing', 'accepted', 'ended')),
+  created_at timestamptz not null default now());
+create index if not exists calls_space_idx on calls(space_id, created_at desc);
+alter table calls enable row level security;
+drop policy if exists calls_r on calls;
+drop policy if exists calls_i on calls;
+drop policy if exists calls_u on calls;
+create policy calls_r on calls for select using (space_id = my_space());
+create policy calls_i on calls for insert with check (space_id = my_space() and caller = auth.uid());
+create policy calls_u on calls for update using (space_id = my_space() and caller = auth.uid())
+  with check (space_id = my_space() and caller = auth.uid());
+revoke all on calls from anon, authenticated;
+grant select, insert on calls to authenticated;
+grant update (status) on calls to authenticated;
+
+-- Cuộc gọi đang đổ chuông (do người kia gọi, trong 30 giây gần nhất), kèm số mili giây còn lại của lần đổ chuông.
+create or replace function ringing_call()
+returns table(id uuid, video boolean, left_ms integer)
+language sql stable security invoker set search_path = public as $$
+  select c.id, c.video,
+         greatest(1000, 30000 - (extract(epoch from (now() - c.created_at)) * 1000)::integer)
+  from calls c
+  where c.space_id = my_space() and c.caller <> auth.uid() and c.status = 'ringing'
+    and c.created_at > now() - interval '30 seconds'
+  order by c.created_at desc limit 1
+$$;
+revoke all on function ringing_call() from public, anon;
+grant execute on function ringing_call() to authenticated;
+
+-- Dọn dòng cũ khi có cuộc gọi mới (giữ 30 ngày gần nhất), không cần cron.
+create or replace function calls_trim() returns trigger language plpgsql security definer set search_path = public as $$
+begin delete from calls where space_id = new.space_id and created_at < now() - interval '30 days'; return null; end $$;
+drop trigger if exists calls_trim_t on calls;
+create trigger calls_trim_t after insert on calls for each statement execute function calls_trim();
