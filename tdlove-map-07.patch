diff --git a/components/TripBar.tsx b/components/TripBar.tsx
new file mode 100644
index 0000000..77121d9
--- /dev/null
+++ b/components/TripBar.tsx
@@ -0,0 +1,115 @@
+'use client'
+import { useCallback, useEffect, useRef, useState } from 'react'
+import Link from 'next/link'
+import { sb } from '@/lib/supabase'
+import { useApp } from '@/lib/ctx'
+import { MAX_POINTS, STALE_MS, TRIP_CHANGED, TRIP_STOP, accept, fmtDur, fmtKm, uid, type Fix, type Pt } from '@/lib/trip'
+
+const qk = (id: string) => `tdlove.trip.q.${id}`, sk = (id: string) => `tdlove.trip.st.${id}`
+export const AWAKE_KEY = 'tdlove.trip.awake'
+type St = { dist: number; count: number; last: Fix | null }
+const rd = <T,>(k: string, d: T): T => { try { return JSON.parse(localStorage.getItem(k) ?? 'null') ?? d } catch { return d } }
+const wr = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch { } }
+
+// Chạy ở mọi màn hình của app (MAP-07): giữ việc ghi điểm khi bạn chuyển sang tab khác, và luôn hiện thanh báo rõ ràng khi đang ghi.
+// Điểm đi vào hàng đợi (lưu cả ở localStorage), cứ ~20 giây gửi một lần; mất mạng thì giữ lại gửi sau.
+export default function TripBar() {
+  const { me } = useApp()
+  const [trip, setTrip] = useState<any>(null)
+  const [, tick] = useState(0)
+  const [note, setNote] = useState(''); const [gps, setGps] = useState(''); const [busy, setBusy] = useState(false)
+  const q = useRef<Pt[]>([]), st = useRef<St>({ dist: 0, count: 0, last: null }), flushing = useRef(false), tripRef = useRef<any>(null)
+  const wake = useRef<any>(null)
+  tripRef.current = trip
+
+  const changed = () => window.dispatchEvent(new Event(TRIP_CHANGED))
+  // Gửi các điểm đang chờ lên Supabase. id do app sinh nên gửi lại không bị trùng điểm.
+  const flush = useCallback(async (): Promise<boolean> => {
+    const t = tripRef.current; if (!t) return true
+    if (flushing.current) return false
+    flushing.current = true
+    try {
+      if (q.current.length) {
+        const batch = q.current.slice(0, 300)
+        const { error } = await sb.from('location_history').upsert(batch, { onConflict: 'id', ignoreDuplicates: true })
+        if (error) { if (error.code === '23503') { q.current = []; wr(qk(t.id), []) } return false }   // hành trình đã bị xóa: bỏ hàng đợi
+        q.current = q.current.slice(batch.length); wr(qk(t.id), q.current)
+      }
+      const s = st.current   // last_at = lần cuối app còn đang ghi (không phải lúc có điểm cuối), để đứng yên ở quán lâu không bị coi là bỏ quên
+      const { error } = await sb.from('trips').update({ distance_m: Math.round(s.dist), point_count: s.count, last_at: new Date().toISOString() }).eq('id', t.id)
+      if (!error) { changed(); if (!q.current.length) setNote('') }
+      return !error && !q.current.length
+    } finally { flushing.current = false }
+  }, [])
+
+  // Đọc hành trình đang ghi của mình; app đóng quá lâu thì tự dừng, còn lại thì ghi tiếp
+  const load = useCallback(async () => {
+    const { data } = await sb.from('trips').select('*').eq('user_id', me.id).is('ended_at', null).limit(1)
+    let cur = data?.[0] ?? null
+    if (cur && tripRef.current?.id !== cur.id) {
+      q.current = rd<Pt[]>(qk(cur.id), []); const s = rd<St | null>(sk(cur.id), null)
+      st.current = s ?? { dist: cur.distance_m ?? 0, count: cur.point_count ?? 0, last: null }
+    }
+    if (cur && Date.now() - new Date(cur.last_at ?? cur.started_at).getTime() > STALE_MS) {
+      tripRef.current = cur; await flush()
+      const end = cur.last_at ?? cur.started_at   // thời điểm cuối cùng app còn ghi
+      await sb.from('trips').update({ ended_at: end }).eq('id', cur.id)
+      localStorage.removeItem(qk(cur.id)); localStorage.removeItem(sk(cur.id))
+      setNote(`Hành trình “${cur.name}” đã tự dừng vì app đóng quá lâu. Các điểm đã ghi vẫn được giữ.`); cur = null; changed()
+    }
+    setTrip((p: any) => cur && p?.id === cur.id ? { ...p, ...cur } : cur)
+  }, [me.id, flush])
+  useEffect(() => { load(); const f = () => load(); window.addEventListener(TRIP_CHANGED, f); return () => window.removeEventListener(TRIP_CHANGED, f) }, [load])
+
+  const stop = useCallback(async (why = '') => {
+    const t = tripRef.current; if (!t) return
+    setBusy(true)
+    await flush()   // thử gửi nốt các điểm còn chờ
+    if (q.current.length) { setBusy(false); return setNote('Chưa có mạng nên chưa lưu được các điểm cuối. Bạn vẫn đang ghi, hãy bấm Dừng lại khi có mạng nhé.') }
+    const end = new Date().toISOString()
+    const { error } = await sb.from('trips').update({ ended_at: end, distance_m: Math.round(st.current.dist), point_count: st.current.count, last_at: end }).eq('id', t.id)
+    setBusy(false)
+    if (error) return setNote('Chưa dừng được hành trình: ' + error.message)
+    localStorage.removeItem(qk(t.id)); localStorage.removeItem(sk(t.id))
+    setTrip(null); setNote(why); setGps(''); changed()
+  }, [flush])
+  useEffect(() => { const f = () => { stop() }; window.addEventListener(TRIP_STOP, f); return () => window.removeEventListener(TRIP_STOP, f) }, [stop])
+
+  // Có hành trình đang ghi: theo dõi GPS, gửi định kỳ, giữ màn hình sáng
+  const id = trip?.id as string | undefined
+  useEffect(() => {
+    if (!id) return
+    const spaceId = tripRef.current.space_id
+    const onPos = (p: GeolocationPosition) => {
+      setGps('')
+      const f: Fix = { lat: p.coords.latitude, lng: p.coords.longitude, acc: p.coords.accuracy ?? null, t: p.timestamp || Date.now() }
+      const a = accept(st.current.last, f); if (!a.ok) return
+      st.current = { dist: st.current.dist + a.d, count: st.current.count + 1, last: f }
+      q.current.push({ id: uid(), trip_id: id, space_id: spaceId, lat: f.lat, lng: f.lng, accuracy: f.acc, recorded_at: new Date(f.t).toISOString() })
+      wr(qk(id), q.current); wr(sk(id), st.current)
+      if (st.current.count >= MAX_POINTS) stop(`Hành trình đã tự dừng vì đủ ${MAX_POINTS} điểm. Bạn có thể bắt đầu một hành trình mới.`)
+    }
+    const onErr = (e: GeolocationPositionError) => setGps(e.code === 1 ? 'Chưa có quyền vị trí, hãy cho phép trong cài đặt trình duyệt' : 'Chưa lấy được vị trí, đang thử lại…')
+    const watch = navigator.geolocation.watchPosition(onPos, onErr, { enableHighAccuracy: true, maximumAge: 5000, timeout: 30000 })
+    const every = setInterval(() => { flush(); tick(x => x + 1) }, 20000), show = setInterval(() => tick(x => x + 1), 5000)
+    const lock = async () => {   // màn hình tắt thì trình duyệt ngừng cấp vị trí, nên mặc định giữ màn hình sáng khi đang ghi
+      try { if (localStorage.getItem(AWAKE_KEY) !== '0' && 'wakeLock' in navigator && document.visibilityState === 'visible') wake.current = await (navigator as any).wakeLock.request('screen') } catch { }
+    }
+    const vis = () => { if (document.visibilityState === 'hidden') flush(); else { lock(); load() } }
+    const online = () => { flush() }
+    lock(); document.addEventListener('visibilitychange', vis); window.addEventListener('online', online); window.addEventListener('pagehide', online)
+    return () => {
+      navigator.geolocation.clearWatch(watch); clearInterval(every); clearInterval(show)
+      document.removeEventListener('visibilitychange', vis); window.removeEventListener('online', online); window.removeEventListener('pagehide', online)
+      try { wake.current?.release() } catch { }; wake.current = null
+    }
+  }, [id, flush, stop, load])
+
+  if (!trip) return note ? <div className="rec" role="status"><span>{note}</span><button className="pill" onClick={() => setNote('')}>Đóng</button></div> : null
+  const s = st.current
+  return <div className="rec on" role="status">
+    <i className="dot" aria-hidden="true" />
+    <Link href="/map" style={{ flex: 1 }}>Đang ghi hành trình · {fmtKm(s.dist)} · {fmtDur(Date.now() - new Date(trip.started_at).getTime())}{gps ? ` · ${gps}` : ''}{note ? ` · ${note}` : ''}</Link>
+    <button className="pill" onClick={() => stop()} disabled={busy}>{busy ? 'Đang lưu…' : 'Dừng'}</button>
+  </div>
+}
diff --git a/components/TripPanel.tsx b/components/TripPanel.tsx
new file mode 100644
index 0000000..4d4f64d
--- /dev/null
+++ b/components/TripPanel.tsx
@@ -0,0 +1,93 @@
+'use client'
+import { useCallback, useEffect, useState } from 'react'
+import { sb } from '@/lib/supabase'
+import { useApp } from '@/lib/ctx'
+import { ok } from '@/lib/util'
+import { TRIP_CHANGED, TRIP_STOP, fmtDur, fmtKm, loadPoints, startTrip } from '@/lib/trip'
+import { AWAKE_KEY } from '@/components/TripBar'
+
+export type Route = { points: [number, number][]; name: string; mine: boolean }
+const day = (s: string) => new Date(s).toLocaleDateString('vi-VN')
+
+// Bảng "Hành trình" trên trang Bản đồ (MAP-07): bắt đầu/dừng ghi, xem lại trên bản đồ, cho người ấy xem, xóa
+export default function TripPanel({ onShow }: { onShow: (r: Route | null) => void }) {
+  const { me, space, partner } = useApp()
+  const [trips, setTrips] = useState<any[]>([]); const [plans, setPlans] = useState<any[]>([])
+  const [name, setName] = useState(''); const [planId, setPlanId] = useState(''); const [awake, setAwake] = useState(true)
+  const [busy, setBusy] = useState(false); const [msg, setMsg] = useState(''); const [openId, setOpenId] = useState<string | null>(null)
+  const load = useCallback(() => { sb.from('trips').select('*, plans(name)').order('started_at', { ascending: false }).limit(50).then(r => setTrips(r.data ?? [])) }, [])
+  useEffect(() => {
+    load(); window.addEventListener(TRIP_CHANGED, load)
+    sb.from('plans').select('id,name,status').neq('status', 'Hủy').order('start_date', { ascending: false, nullsFirst: true }).limit(20).then(r => setPlans(r.data ?? []))
+    setAwake(localStorage.getItem(AWAKE_KEY) !== '0')
+    return () => { window.removeEventListener(TRIP_CHANGED, load); onShow(null) }
+  }, [load])
+  const active = trips.find(t => t.user_id === me.id && !t.ended_at)
+  const mine = trips.filter(t => t.user_id === me.id && t.ended_at), theirs = trips.filter(t => t.user_id !== me.id)
+
+  function start() {
+    setMsg('')
+    if (!navigator.geolocation) return setMsg('Trình duyệt này không hỗ trợ định vị.')
+    const plan = plans.find(p => p.id === planId)
+    const n = name.trim() || plan?.name || `Hành trình ${day(new Date().toISOString())}`
+    if ([...n].length > 60) return setMsg('Tên hành trình tối đa 60 ký tự')
+    setBusy(true)
+    // xin quyền vị trí ngay khi bấm nút (iOS/Safari yêu cầu), rồi mới tạo hành trình
+    navigator.geolocation.getCurrentPosition(async () => {
+      try { localStorage.setItem(AWAKE_KEY, awake ? '1' : '0'); await startTrip(space.id, n, planId || null); setName(''); setPlanId('') }
+      catch (e: any) { setMsg(e.message) }
+      setBusy(false)
+    }, () => { setMsg('Không lấy được vị trí. Hãy cho phép trang web truy cập vị trí trong cài đặt trình duyệt.'); setBusy(false) }, { enableHighAccuracy: true, timeout: 20000 })
+  }
+  async function view(t: any) {
+    if (openId === t.id) { setOpenId(null); return onShow(null) }
+    setMsg(''); setBusy(true)
+    try {
+      const points = await loadPoints(t.id)
+      if (points.length < 2) setMsg('Hành trình này chưa đủ điểm để vẽ đường đi.')
+      else { setOpenId(t.id); onShow({ points, name: t.name, mine: t.user_id === me.id }) }
+    } catch (e: any) { setMsg('Không tải được hành trình: ' + e.message) }
+    setBusy(false)
+  }
+  const share = async (t: any) => { if (await ok(sb.from('trips').update({ shared: !t.shared }).eq('id', t.id), 'Không đổi được chế độ chia sẻ')) load() }
+  async function del(t: any) {
+    if (!confirm(`Xóa hành trình “${t.name}”? Toàn bộ các điểm đã ghi sẽ bị xóa vĩnh viễn.`)) return
+    if (await ok(sb.from('trips').delete().eq('id', t.id), 'Không xóa được hành trình')) { if (openId === t.id) { setOpenId(null); onShow(null) } load() }
+  }
+  async function delAll() {
+    if (!confirm(`Xóa tất cả ${mine.length} hành trình đã ghi của bạn? Không khôi phục được.`)) return
+    if (await ok(sb.from('trips').delete().eq('user_id', me.id).not('ended_at', 'is', null), 'Không xóa được')) { setOpenId(null); onShow(null); load() }
+  }
+
+  const row = (t: any, own: boolean) => <div key={t.id} className="k" style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
+    <b>{t.name}</b>
+    <div className="s">{day(t.started_at)} · {fmtKm(t.distance_m)} · {fmtDur(new Date(t.ended_at ?? t.last_at ?? t.started_at).getTime() - new Date(t.started_at).getTime())} · {t.point_count} điểm{t.plans?.name ? ` · ${t.plans.name}` : ''}</div>
+    {!own && <div className="s">Người ấy chia sẻ với bạn</div>}
+    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+      <button className={'pill' + (openId === t.id ? ' on' : '')} onClick={() => view(t)} disabled={busy} aria-pressed={openId === t.id}>{openId === t.id ? 'Ẩn đường đi' : 'Xem trên bản đồ'}</button>
+      {own && partner && <button className={'pill' + (t.shared ? ' on' : '')} onClick={() => share(t)} aria-pressed={t.shared}>{t.shared ? 'Người ấy đang xem được' : 'Cho người ấy xem'}</button>}
+      {own && <button className="pill" onClick={() => del(t)}>Xóa</button>}
+    </div>
+  </div>
+
+  return <>
+    <div className="k li" style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
+      {active ? <>
+        <b>Đang ghi: {active.name}</b>
+        <div className="s">{fmtKm(active.distance_m)} · {active.point_count} điểm. Chỉ ghi khi app đang mở; thanh trên cùng cho bạn dừng ở bất cứ màn hình nào.</div>
+        <button className="pill on" onClick={() => window.dispatchEvent(new Event(TRIP_STOP))} style={{ alignSelf: 'flex-start' }}>Dừng ghi hành trình</button>
+      </> : <>
+        <b>Ghi lại hành trình</b>
+        <div className="s">Chỉ ghi khi bạn bấm bắt đầu. Chỉ mình bạn xem được, trừ khi bạn bấm “Cho người ấy xem”. Xóa được bất cứ lúc nào.</div>
+        <label className="k s" style={{ display: 'block' }}><input value={name} onChange={e => setName(e.target.value)} placeholder="Tên hành trình (không bắt buộc)" aria-label="Tên hành trình" /></label>
+        {plans.length > 0 && <label className="s">Gắn với kế hoạch
+          <select value={planId} onChange={e => setPlanId(e.target.value)} style={{ maxWidth: '100%', width: '100%', marginTop: 4 }}><option value="">Không gắn</option>{plans.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}</select></label>}
+        <label className="s" style={{ display: 'flex', gap: 8, alignItems: 'center' }}><input type="checkbox" checked={awake} onChange={e => setAwake(e.target.checked)} style={{ width: 22, height: 22, flex: 'none' }} />Giữ màn hình sáng khi đang ghi (nên bật: màn hình tắt thì trình duyệt ngừng cấp vị trí, nhưng tốn pin hơn)</label>
+        <button className="pill on" onClick={start} disabled={busy} style={{ alignSelf: 'flex-start' }}>{busy ? 'Đang bắt đầu…' : 'Bắt đầu ghi'}</button>
+      </>}
+      {msg && <div className="s" role="alert">{msg}</div>}
+    </div>
+    {mine.length > 0 && <><b>Hành trình của mình</b>{mine.map(t => row(t, true))}<button className="pill" onClick={delAll} style={{ alignSelf: 'flex-start' }}>Xóa tất cả hành trình đã ghi</button></>}
+    {theirs.length > 0 && <><b>Người ấy chia sẻ</b>{theirs.map(t => row(t, false))}</>}
+  </>
+}
diff --git a/lib/trip.ts b/lib/trip.ts
new file mode 100644
index 0000000..7045652
--- /dev/null
+++ b/lib/trip.ts
@@ -0,0 +1,48 @@
+// Lịch sử hành trình (MAP-07): lọc điểm GPS, tính quãng đường, tải/ghi điểm
+import { sb } from '@/lib/supabase'
+import { km } from '@/lib/util'
+
+export type Fix = { lat: number; lng: number; acc: number | null; t: number }   // t: mili giây
+export type Pt = { id: string; trip_id: string; space_id: string; lat: number; lng: number; accuracy: number | null; recorded_at: string }
+
+export const TRIP_CHANGED = 'tdlove-trip-changed', TRIP_STOP = 'tdlove-trip-stop'
+export const MAX_POINTS = 6000          // đủ cho khoảng 8 tiếng đi liên tục; quá thì tự dừng để không phình dung lượng
+export const STALE_MS = 2 * 3600e3      // app đóng quá 2 tiếng thì hành trình tự dừng, tránh ghi quên
+const MIN_STEP_M = 15, MIN_GAP_MS = 5000, MAX_ACC_M = 80, MAX_SPEED = 70   // m, ms, m, m/s (252 km/h)
+
+// Có nên lưu điểm mới không, và đi thêm bao nhiêu mét so với điểm đã lưu trước đó
+export function accept(prev: Fix | null, f: Fix): { ok: boolean; d: number } {
+  const no = { ok: false, d: 0 }
+  if (f.acc != null && f.acc > MAX_ACC_M) return no                      // sai số quá lớn (thường là mới bật GPS)
+  if (!prev) return { ok: true, d: 0 }
+  const dt = f.t - prev.t; if (dt < MIN_GAP_MS) return no                // dày quá
+  const d = km(prev, f) * 1000
+  if (d < Math.max(MIN_STEP_M, (f.acc ?? 0) / 2)) return no              // chưa nhích ra khỏi vùng sai số: đứng yên thì không ghi thêm
+  if (dt < 60000 && d / (dt / 1000) > MAX_SPEED) return no               // nhảy vọt vô lý trong thời gian ngắn: nhiễu GPS (tách khỏi trường hợp mất sóng lâu rồi xuất hiện ở xa)
+  return { ok: true, d }
+}
+
+export const fmtKm = (m: number) => m < 1000 ? `${Math.round(m)} m` : `${(m / 1000).toFixed(1).replace('.', ',')} km`
+export const fmtDur = (ms: number) => {
+  const min = Math.floor(ms / 60000); if (min < 1) return 'dưới 1 phút'
+  return min < 60 ? `${min} phút` : `${Math.floor(min / 60)} giờ ${min % 60 ? (min % 60) + ' phút' : ''}`.trim()
+}
+export const uid = () => (globalThis.crypto as any)?.randomUUID?.() ?? 'p' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10)
+
+// Bắt đầu ghi một hành trình mới (mỗi người một hành trình đang ghi, do chỉ mục unique ở phase11.sql)
+export async function startTrip(spaceId: string, name: string, planId: string | null) {
+  const { data, error } = await sb.from('trips').insert({ space_id: spaceId, name, plan_id: planId }).select('*').single()
+  if (error) throw new Error(error.code === '23505' ? 'Bạn đang ghi một hành trình rồi, hãy dừng nó trước' : error.message)
+  window.dispatchEvent(new Event(TRIP_CHANGED))
+  return data
+}
+// Tải toàn bộ điểm của một hành trình (Supabase trả tối đa 1000 dòng mỗi lần nên phải lấy từng trang)
+export async function loadPoints(tripId: string): Promise<[number, number][]> {
+  const out: [number, number][] = []
+  for (let from = 0; ; from += 1000) {
+    const { data, error } = await sb.from('location_history').select('lat,lng').eq('trip_id', tripId).order('recorded_at').range(from, from + 999)
+    if (error) throw new Error(error.message)
+    out.push(...(data ?? []).map(r => [r.lat, r.lng] as [number, number]))
+    if ((data?.length ?? 0) < 1000) return out
+  }
+}
