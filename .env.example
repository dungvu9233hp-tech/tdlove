NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Máy chủ TURN để gọi qua 4G (đăng ký miễn phí tại metered.ca). Nhiều địa chỉ cách nhau bằng dấu phẩy, nên có cả cổng 443 và turns: cho mạng bị chặn
# Ví dụ: turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=

# Web Push (CHAT-04, CALL-05, ANNIV-04): khóa công khai VAPID, xem supabase/functions/README.md
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Giới hạn dung lượng video (MB). Gói Supabase miễn phí: 50. Gói Pro đã nâng giới hạn tệp: 200 (đúng SRS MOM-03)
NEXT_PUBLIC_MAX_VIDEO_MB=50

# Tìm GIF trên GIPHY trong Chat và bình luận (không bắt buộc; thiếu thì vẫn dùng được GIF tải lên từ máy). Tạo khóa miễn phí tại developers.giphy.com
NEXT_PUBLIC_GIPHY_KEY=
