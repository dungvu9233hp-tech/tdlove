diff --git a/app/globals.css b/app/globals.css
index 18856d7..d13a061 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -1,4 +1,4 @@
-:root{--ink:#5B1F3A;--ink2:#8A3358;--pink:#FF8FB8;--shadow:#FFB3CF}
+:root{--f1:'Baloo 2';--f2:'Quicksand';--ink:#5B1F3A;--ink2:#8A3358;--pink:#FF8FB8;--shadow:#FFB3CF}
 *{margin:0;padding:0;box-sizing:border-box}
 body{background:#FFF0F6;font-family:var(--f2),system-ui,sans-serif;font-size:16px;color:var(--ink)}
 a{color:inherit;text-decoration:none}
diff --git a/app/layout.tsx b/app/layout.tsx
index 7761dfa..47e020d 100644
--- a/app/layout.tsx
+++ b/app/layout.tsx
@@ -1,11 +1,16 @@
 import type { Metadata, Viewport } from 'next'
-import { Baloo_2, Quicksand } from 'next/font/google'
+import '@fontsource/baloo-2/latin-700.css'
+import '@fontsource/baloo-2/latin-800.css'
+import '@fontsource/baloo-2/vietnamese-700.css'
+import '@fontsource/baloo-2/vietnamese-800.css'
+import '@fontsource/quicksand/latin-600.css'
+import '@fontsource/quicksand/latin-700.css'
+import '@fontsource/quicksand/vietnamese-600.css'
+import '@fontsource/quicksand/vietnamese-700.css'
 import './globals.css'
 import Sw from '@/components/Sw'
-const f1 = Baloo_2({ subsets: ['vietnamese', 'latin'], weight: ['700', '800'], variable: '--f1' })
-const f2 = Quicksand({ subsets: ['vietnamese', 'latin'], weight: ['600', '700'], variable: '--f2' })
 export const metadata: Metadata = { title: 'tdlove', description: 'Góc nhỏ của hai đứa mình', manifest: '/manifest.webmanifest', robots: { index: false, follow: false }, icons: { icon: '/icons/icon-192.png', apple: '/icons/apple-touch-icon.png' } }
 export const viewport: Viewport = { themeColor: '#FF8FB8', width: 'device-width', initialScale: 1 }
 export default function Root({ children }: { children: React.ReactNode }) {
-  return <html lang="vi" className={`${f1.variable} ${f2.variable}`}><body>{children}<Sw /></body></html>
+  return <html lang="vi" ><body>{children}<Sw /></body></html>
 }
