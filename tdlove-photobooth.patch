@@ -0,0 +1,25 @@
+.pb{display:flex;flex-direction:column;gap:12px;padding-bottom:90px}
+.pb-box{display:flex;flex-direction:column;gap:8px}
+.pb-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
+.pb-row .pill{cursor:pointer;border:1px solid var(--line2)}
+.pb-sw{width:30px;height:30px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1.5px var(--stitch);padding:0;cursor:pointer;background:none}
+.pb-sw.on{box-shadow:0 0 0 3px var(--rose-d)}
+.pb-tray img{width:56px;height:56px;object-fit:cover;border-radius:12px;border:2px solid #fff;box-shadow:0 0 0 1.5px var(--stitch);cursor:pointer}
+.pb-stagewrap{display:flex;justify-content:center}
+.pb-stage{position:relative;overflow:hidden;border-radius:6px;box-shadow:0 6px 22px rgba(74,29,53,.2);max-width:100%;touch-action:pan-y;user-select:none;-webkit-user-select:none}
+.pb-in{position:absolute;left:0;top:0;transform-origin:0 0;background-size:100% 100%}
+.pb-ov{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
+.pb-it{position:absolute;touch-action:none;outline:0 dashed transparent}
+.pb-it.on{outline-style:dashed;outline-color:var(--rose-d)}
+.pb-ar{position:absolute;overflow:hidden;background:rgba(255,255,255,.45);display:flex;align-items:center;justify-content:center;color:var(--ink2);font-weight:700;border:0}
+.pb-ar img{position:absolute;max-width:none;pointer-events:none}
+.pb-tx{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-weight:700;white-space:nowrap;pointer-events:none}
+.pb-h{position:absolute;border-radius:50%;background:var(--rose-d);border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3);touch-action:none;box-sizing:border-box}
+.pb-rot{cursor:grab}.pb-sz{cursor:nwse-resize}
+.pb-tool input[type=range]{width:100%}
+.pb-zoom{display:flex;flex-direction:column;gap:4px;font:700 14px var(--f2)}
+.pb-txt{flex:1 1 140px;min-width:0;border:1px solid var(--line2);border-radius:12px;padding:8px 10px;font:600 15px var(--f2)}
+.pb-stk{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:8px}
+.pb-stk button{aspect-ratio:1;background:#fff;border:1.5px solid var(--stitch);border-radius:14px;padding:6px;cursor:pointer;display:flex;align-items:center;justify-content:center}
+.pb-stk img{max-width:100%;max-height:100%;object-fit:contain}
+.pb-act .btn{flex:1 1 160px}
