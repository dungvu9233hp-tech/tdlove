+import { sb } from '@/lib/supabase'
+
+export const hasTikTok = (s: string) => /https?:\/\/(?:[\w-]+\.)?tiktok\.com\//i.test(s)
+
+// Trình phát nhúng chính thức của TikTok (developers.tiktok.com/doc/embed-player); chỉ nhận mã video là số
+export const embedSrc = (id: string) =>
+  /^\d{8,25}$/.test(id) ? `https://www.tiktok.com/player/v1/${id}?controls=1&description=1&music_info=1&rel=0&autoplay=1` : ''
+
+// Địa chỉ Edge Function `clip`, dùng trong Phím tắt iPhone
+export const funcUrl = `${process.env.NEXT_PUBLIC_SUPABASE_URL}/functions/v1/clip`
+
+// Gửi một link TikTok (hoặc đoạn chữ chứa link) cho người kia qua Edge Function `clip`
+export async function sendClip(url: string, note?: string): Promise<{ ok: boolean; message: string }> {
+  const { data, error } = await sb.functions.invoke('clip', { body: { url, note } })
+  if (!error) return { ok: !!data?.ok, message: data?.message ?? 'Đã gửi' }
+  let msg = ''
+  try { msg = (await (error as any).context?.json?.())?.message ?? '' } catch { /* không đọc được nội dung lỗi */ }
+  return { ok: false, message: msg || 'Chưa gửi được. Kiểm tra mạng và đã deploy hàm clip chưa nhé.' }
+}
diff --git a/supabase/functions/clip/index.ts b/supabase/functions/clip/index.ts
new file mode 100644
index 0000000..b1af4cc
--- /dev/null
+++ b/supabase/functions/clip/index.ts
@@ -0,0 +1,86 @@
+// Edge Function `clip`: nhận link TikTok, ghi vào bảng clips và báo cho người kia (ENT-02, ENT-04, ENT-05).
+// Hai cách gọi:
+//  1) Từ app: supabase.functions.invoke('clip', { body: { url } }), kèm JWT của người đang đăng nhập.
+//  2) Từ Phím tắt iPhone: POST có header `x-share-token: <mã tạo trong app, trang Giải trí>`, không có JWT.
+// Vì cách 2 không có JWT nên phải deploy bằng: supabase functions deploy clip --no-verify-jwt
+// (hàm tự xác thực: hoặc mã gửi nhanh, hoặc JWT; thiếu cả hai thì trả 401).
+import { createClient } from 'npm:@supabase/supabase-js@2'
+import webpush from 'npm:web-push@3.6.7'
+import { canonical, clean, extractUrl, httpsUrl, resolveVideo } from './tiktok.ts'
+
+const cors = { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type, x-share-token' }
+const reply = (ok: boolean, message: string, status = 200, extra: Record<string, unknown> = {}) =>
+  new Response(JSON.stringify({ ok, message, ...extra }), { status, headers: { ...cors, 'Content-Type': 'application/json' } })
+const sha256 = async (s: string) =>
+  [...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)))].map(b => b.toString(16).padStart(2, '0')).join('')
+
+// oEmbed chính thức của TikTok: lấy caption, tên tác giả, ảnh bìa. Lỗi thì vẫn lưu clip, chỉ thiếu mô tả.
+async function oembed(link: string) {
+  try {
+    const r = await fetch('https://www.tiktok.com/oembed?url=' + encodeURIComponent(link), { signal: AbortSignal.timeout(6000) })
+    if (!r.ok) return null
+    const j = await r.json()
+    return { title: clean(j.title, 300), author: clean(j.author_name, 80), thumb: httpsUrl(j.thumbnail_url) }
+  } catch { return null }
+}
+
+Deno.serve(async req => {
+  if (req.method === 'OPTIONS') return new Response('ok', { headers: cors })
+  if (req.method !== 'POST') return reply(false, 'Chỉ nhận yêu cầu POST', 405)
+  try {
+    const url = Deno.env.get('SUPABASE_URL')!
+    const admin = createClient(url, Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!)
+
+    // 1. Ai đang gửi?
+    let uid: string | null = null
+    const tok = req.headers.get('x-share-token')?.trim()
+    if (tok) {
+      if (!/^[0-9a-f]{64}$/.test(tok)) return reply(false, 'Mã gửi nhanh không đúng. Hãy tạo mã mới trong app (Giải trí).', 401)
+      const { data } = await admin.from('share_tokens').select('user_id').eq('token_hash', await sha256(tok)).maybeSingle()
+      uid = data?.user_id ?? null
+    } else {
+      const user = createClient(url, Deno.env.get('SUPABASE_ANON_KEY')!, { global: { headers: { Authorization: req.headers.get('Authorization') ?? '' } } })
+      uid = (await user.auth.getUser()).data.user?.id ?? null
+    }
+    if (!uid) return reply(false, 'Chưa đăng nhập, hoặc mã gửi nhanh đã bị thay. Hãy tạo mã mới trong app (Giải trí).', 401)
+    const { data: me } = await admin.from('profiles').select('space_id,display_name').eq('id', uid).maybeSingle()
+    if (!me?.space_id) return reply(false, 'Bạn chưa vào Space nào', 403)
+
+    // 2. Đọc link: nhận JSON {url, note} hoặc chữ thường (Phím tắt có thể gửi thẳng đoạn văn bản được chia sẻ)
+    const raw = (await req.text()).slice(0, 4000)
+    let body: any; try { body = JSON.parse(raw) } catch { body = { url: raw } }
+    const link = extractUrl(String(body?.url ?? ''))
+    if (!link) return reply(false, 'Không thấy đường link nào trong nội dung đã gửi', 400)
+    const v = await resolveVideo(link)
+    if (!v) return reply(false, 'Chỉ nhận link video TikTok. Link ảnh, video riêng tư hoặc link hỏng thì chưa mở được.', 422)
+    const full = canonical(v)
+    const meta = await oembed(full)
+
+    // 3. Lưu (gửi lại đúng clip cũ thì không thêm dòng)
+    const { error } = await admin.from('clips').insert({
+      space_id: me.space_id, sender: uid, video_id: v.id, url: full,
+      title: meta?.title ?? null, author_name: meta?.author ?? null, thumb_url: meta?.thumb ?? null, note: clean(body?.note, 200),
+    })
+    if (error) {
+      if (error.code === '23505') return reply(true, 'Clip này đã gửi rồi', 200, { duplicate: true })
+      console.error('clip insert', error.message)
+      return reply(false, 'Chưa lưu được clip, thử lại nhé', 500)
+    }
+
+    // 4. Báo cho người kia (lỗi thì bỏ qua, clip đã lưu rồi)
+    const { data: partner } = await admin.from('profiles').select('display_name').eq('space_id', me.space_id).neq('id', uid).maybeSingle()
+    try {
+      webpush.setVapidDetails(Deno.env.get('VAPID_SUBJECT')!, Deno.env.get('VAPID_PUBLIC_KEY')!, Deno.env.get('VAPID_PRIVATE_KEY')!)
+      const { data: subs } = await admin.from('push_subscriptions').select('endpoint,p256dh,auth').eq('space_id', me.space_id).neq('user_id', uid)
+      const payload = JSON.stringify({ kind: 'clip', title: me.display_name ?? 'Người ấy', body: meta?.title ? 'Gửi bạn một clip: ' + meta.title.slice(0, 80) : 'Gửi bạn một clip TikTok', url: '/fun', tag: 'clip' })
+      for (const s of subs ?? []) {
+        try { await webpush.sendNotification({ endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } }, payload, { TTL: 86400 }) }
+        catch (e: any) {
+          if (e?.statusCode === 404 || e?.statusCode === 410) await admin.from('push_subscriptions').delete().eq('endpoint', s.endpoint)
+          else console.error('clip push', e?.statusCode, e?.body)
+        }
+      }
+    } catch (e) { console.error('clip push', e) }
+    return reply(true, `Đã gửi cho ${partner?.display_name ?? 'người ấy'}`)
+  } catch (e) { console.error(e); return reply(false, 'Lỗi máy chủ, thử lại sau nhé', 500) }
+})
diff --git a/supabase/functions/clip/tiktok.ts b/supabase/functions/clip/tiktok.ts
new file mode 100644
index 0000000..2819ae7
--- /dev/null
+++ b/supabase/functions/clip/tiktok.ts
@@ -0,0 +1,53 @@
+// Phần thuần (không dùng API riêng của Deno) của Edge Function `clip`: tách link TikTok khỏi đoạn văn bản, đổi link rút gọn
+// (vm.tiktok.com, vt.tiktok.com, tiktok.com/t/...) thành mã video. Chỉ đi theo chuyển hướng trong các tên miền của TikTok,
+// để người ngoài không lợi dụng hàm này gọi tới địa chỉ khác (SSRF).
+
+export type Video = { id: string; user: string | null }
+
+const HOST = /^(?:[a-z0-9-]+\.)?tiktok\.com$/i
+const UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1'
+
+// Lấy link đầu tiên trong đoạn văn bản (TikTok hay chia sẻ kèm caption)
+export function extractUrl(s: string): string | null {
+  const m = s.match(/https?:\/\/[^\s<>"']+/i)
+  return m ? m[0].replace(/[).,;!?]+$/, '') : null
+}
+
+export const isTikTok = (u: URL) => u.protocol === 'https:' && HOST.test(u.hostname) && !u.username && !u.password
+
+// Nhận ra link video đầy đủ: /@tên/video/<mã>, /video/<mã>, /v/<mã>.html. Link ảnh (/photo/) không nhận.
+export function parseVideo(u: URL): Video | null {
+  let m = u.pathname.match(/^\/(?:@([\w.-]{1,64})\/)?video\/(\d{8,25})\/?$/)
+  if (m) return { id: m[2], user: m[1] ?? null }
+  m = u.pathname.match(/^\/v\/(\d{8,25})\.html$/)
+  return m ? { id: m[1], user: null } : null
+}
+
+// Đi theo tối đa 4 lần chuyển hướng (từng bước đều phải là tên miền TikTok) cho tới khi ra link video đầy đủ
+export async function resolveVideo(raw: string, f: typeof fetch = fetch): Promise<Video | null> {
+  let u: URL
+  try { u = new URL(raw) } catch { return null }
+  for (let hop = 0; hop < 5; hop++) {
+    if (!isTikTok(u)) return null
+    const v = parseVideo(u)
+    if (v) return v
+    if (hop === 4) return null
+    const r = await f(u.href, { method: 'GET', redirect: 'manual', headers: { 'user-agent': UA, accept: 'text/html' }, signal: AbortSignal.timeout(6000) })
+    r.body?.cancel().catch(() => { })
+    const loc = r.headers.get('location')
+    if (!loc || r.status < 300 || r.status >= 400) return null
+    try { u = new URL(loc, u) } catch { return null }
+  }
+  return null
+}
+
+export const canonical = (v: Video) => v.user ? `https://www.tiktok.com/@${v.user}/video/${v.id}` : `https://www.tiktok.com/video/${v.id}`
+
+// Làm sạch chuỗi lấy từ bên ngoài trước khi lưu
+export const clean = (s: unknown, max: number): string | null => {
+  const t = String(s ?? '').replace(/[\u0000-\u001f\u007f]+/g, ' ').trim().slice(0, max)
+  return t || null
+}
+export const httpsUrl = (s: unknown): string | null => {
+  try { const u = new URL(String(s ?? '')); return u.protocol === 'https:' ? u.href.slice(0, 2000) : null } catch { return null }
+}
diff --git a/supabase/phase13.sql b/supabase/phase13.sql
new file mode 100644
index 0000000..98051d6
--- /dev/null
+++ b/supabase/phase13.sql
@@ -0,0 +1,72 @@
+-- Giai đoạn 13: Giải trí, clip TikTok gửi cho nhau (ENT-01..05)
+-- Chạy trong Supabase > SQL Editor, một lần, SAU phase12.sql. Chạy lại nhiều lần vẫn an toàn.
+-- App KHÔNG lưu video của TikTok: chỉ lưu mã video và vài dòng mô tả (tên, caption), phát bằng trình phát nhúng chính thức của TikTok.
+-- Ghi dữ liệu chỉ qua Edge Function `clip` (dùng service_role), nên không có policy insert cho người dùng.
+
+create table if not exists clips(
+  id uuid primary key default gen_random_uuid(),
+  space_id uuid not null references spaces on delete cascade,
+  sender uuid not null references auth.users on delete cascade,
+  video_id text not null check (video_id ~ '^[0-9]{8,25}$'),            -- mã video trong link TikTok
+  url text not null,                                                    -- link đầy đủ dạng https://www.tiktok.com/@tên/video/mã
+  title text check (title is null or char_length(title) <= 300),        -- caption lấy từ oEmbed
+  author_name text check (author_name is null or char_length(author_name) <= 80),
+  thumb_url text,                                                       -- ảnh bìa (link của TikTok có hạn dùng, app tự ẩn khi hỏng)
+  note text check (note is null or char_length(note) <= 200),
+  seen_at timestamptz,                                                  -- lần đầu người nhận mở xem
+  created_at timestamptz not null default now(),
+  unique(space_id, video_id, sender));                                  -- gửi lại cùng một clip thì không thêm dòng mới
+create index if not exists clips_space_idx on clips(space_id, created_at desc);
+
+alter table clips enable row level security;
+drop policy if exists cl_r on clips; drop policy if exists cl_d on clips;
+create policy cl_r on clips for select using (space_id=my_space());
+create policy cl_d on clips for delete using (space_id=my_space());     -- cả hai người đều dọn được danh sách chung
+revoke insert, update on clips from authenticated, anon;
+
+-- Đánh dấu "đã xem": chỉ người KHÔNG phải người gửi, chỉ ghi lần đầu
+create or replace function open_clip(cid uuid) returns void
+language plpgsql security definer set search_path=public as $$
+begin
+  update clips set seen_at = now()
+   where id = cid and space_id = my_space() and sender <> auth.uid() and seen_at is null;
+end $$;
+revoke all on function open_clip(uuid) from public, anon;
+grant execute on function open_clip(uuid) to authenticated;
+
+-- Mã gửi nhanh cho Phím tắt iPhone (không đăng nhập được trong Phím tắt nên dùng mã riêng của từng người).
+-- Chỉ lưu bản băm SHA-256; mã gốc hiện đúng một lần lúc tạo. Mỗi người một mã, tạo mã mới thì mã cũ hết hiệu lực.
+create table if not exists share_tokens(
+  user_id uuid primary key references auth.users on delete cascade,
+  token_hash text not null,
+  created_at timestamptz not null default now());
+alter table share_tokens enable row level security;                     -- không có policy nào: chỉ hai hàm dưới và Edge Function (service_role) đụng được
+revoke all on share_tokens from anon, authenticated;
+
+create or replace function create_share_token() returns text
+language plpgsql security definer set search_path=public as $$
+declare t text := replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '');   -- 64 ký tự hex
+begin
+  if auth.uid() is null or my_space() is null then raise exception 'Bạn chưa vào Space nào'; end if;
+  insert into share_tokens(user_id, token_hash) values(auth.uid(), encode(sha256(convert_to(t, 'UTF8')), 'hex'))
+    on conflict(user_id) do update set token_hash = excluded.token_hash, created_at = now();
+  return t;
+end $$;
+
+create or replace function revoke_share_token() returns void
+language plpgsql security definer set search_path=public as $$
+begin
+  delete from share_tokens where user_id = auth.uid();
+end $$;
+
+revoke all on function create_share_token() from public, anon;
+revoke all on function revoke_share_token() from public, anon;
+grant execute on function create_share_token() to authenticated;
+grant execute on function revoke_share_token() to authenticated;
+
+-- Realtime: clip mới hiện ngay trên máy người nhận
+do $$ begin
+  if not exists (select 1 from pg_publication_tables where pubname = 'supabase_realtime' and schemaname = 'public' and tablename = 'clips') then
+    alter publication supabase_realtime add table clips;
+  end if;
+end $$;
-- 
