+.memory-hero p,.moments-hero p{color:var(--ink2);font-weight:500}
+.memory-total,.moments-hero-count{background:none;border:0;border-radius:0;box-shadow:none}
+.memory-total strong,.moments-hero-count strong{font:800 30px/1 var(--f2);color:var(--rose-d);letter-spacing:-.03em}
+.memory-total span,.moments-hero-count span{color:var(--ink2);font-weight:600;font-size:12px}
+.map-page .mapbox,.memory-filters,.memory-timeline,.memory-list-panel,.memory-loading,.memory-empty,.moments-empty,.moments-filter-panel,.moment-card,.moments-page>.k.li,.map-mode-tabs{border-radius:14px!important}
+.memory-empty,.moments-empty{background:#EFEEFB!important}
+.memory-list-panel{background:#fff!important}
+.memory-list-item,.memory-list-subitem,.moments-toolbar>*,.moments-filter-panel select{border-radius:10px!important}
+.memory-list-item,.moment-card,.moments-toolbar>*{box-shadow:var(--sh1)!important}
+.moment-card:hover{transform:none;border-color:var(--violet)!important;box-shadow:var(--sh1)!important}
+.memory-list-item:hover{background:#fff;box-shadow:var(--sh1)}
+.memory-list-item.is-active{border-color:var(--violet);background:#EFEEFB;box-shadow:0 0 0 2px rgba(58,51,150,.16)}
+.memory-list-item>div:first-child>span:first-child{background:var(--blush2);border-radius:8px}
+.map-mode-tabs .pill.on,.memory-filter-chip.on,.moments-albums .pill.on{background:var(--violet);border-color:var(--violet);color:#fff}
+.map-mode-tabs .pill:not(.on),.memory-filter-chip,.moments-albums .pill{background:#fff;color:var(--ink2)}
+.memory-timeline input[type=range]{accent-color:var(--violet)}
+.moment-card>b,.memory-list-item>div:first-child>div>div:first-child{color:var(--ink)}
+.moment-day-label{background:var(--peach)!important;border-color:transparent;border-radius:4px;color:var(--ink)!important;box-shadow:none;backdrop-filter:none}
+.moments-toolbar>*:first-child{background:var(--blush)!important}
