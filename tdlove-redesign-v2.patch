+/* tdlove · "Vở ô li, mực tím"
+   Ý tưởng: cuốn vở học trò của hai đứa. Giấy trắng hơi xanh kẻ ô li, lề đỏ kép bên trái, mực tím cho điểm nhấn,
+   bút đỏ cho điều cần để ý, bút dạ quang vàng quét qua dòng khi chạm. Số ngày bên nhau là một tờ lịch bloc.
+   Tệp này nạp SAU globals.css và thay lớp giao diện "Ivory & Rose"; tên class và tên biến giữ nguyên. */
+:root{
+  --f1:'Mali','Be Vietnam Pro',system-ui,sans-serif;
+  --f2:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',sans-serif;
+  --ink:#231F3A;--ink2:#5A5578;--pink:#F4B8C8;--shadow:#E6E3F0;
+  --rose:#E0556B;--rose-d:#B73B54;--blush:#FCE9EE;--blush2:#F8D3DE;--peach:#FFF1A8;--lav:#E9E8F7;
+  --gold:#6A63B5;--gold-d:#3A3396;--gold-l:#C9C6EA;--cream:#F8F7FB;
+  --violet:#3A3396;--rule:#C9D3EC;
+  --line:rgba(35,31,58,.1);--line2:rgba(35,31,58,.2);
+  --sh1:0 1px 0 rgba(35,31,58,.14);--sh2:0 2px 0 rgba(35,31,58,.18);--glow:none;
+  --spring:cubic-bezier(.3,1.35,.5,1);--ease:cubic-bezier(.2,.9,.25,1);
+}
+body{background:#E7E5EF;font-weight:400}
+::selection{background:var(--peach);color:var(--ink)}
+input[type=range],input[type=checkbox],input[type=radio],progress{accent-color:var(--violet)}
+
+/* Trang giấy: ô li xanh nhạt, lề đỏ kép. Không đốm màu, không hạt nhiễu */
+.p{background:
+  linear-gradient(90deg,transparent 29px,rgba(224,85,107,.5) 29px 30px,transparent 30px 33px,rgba(224,85,107,.5) 33px 34px,transparent 34px),
+  repeating-linear-gradient(0deg,transparent 0 31px,rgba(120,150,210,.26) 31px 32px),
+  var(--cream)}
+.p::before,.p::after{content:none;animation:none}
+.b,.stagger>*,.stagger>*:nth-child(n){animation:none}
+
+.h{padding:24px 18px 10px}
+.t1{font:600 28px/1.1 var(--f1);letter-spacing:0}
+b{font-weight:600;font-variation-settings:normal}
+.s{font-size:14px;font-weight:500}
+
+/* Thẻ: mảnh giấy phẳng, một nét mép dưới; ba màu = giấy, bút dạ vàng, mực tím nhạt */
+.k{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:var(--sh1);font-weight:500}
+.pk{background:#FDEFF3;border-color:rgba(224,85,107,.24)}
+.pe{background:#FFF8D2;border-color:rgba(160,128,20,.26)}
+.li{background:#EFEEFB;border-color:rgba(58,51,150,.2)}
+.k.on{background:#EFEEFB;border-color:var(--violet);box-shadow:0 0 0 2px rgba(58,51,150,.16)}
+.k:focus-within{border-color:var(--violet);box-shadow:0 0 0 3px rgba(58,51,150,.15)}
+a.k,button.k{transition:transform .18s var(--ease),background .2s}
+@media (hover:hover) and (prefers-reduced-motion:no-preference){a.k:hover,button.k:hover{transform:none;box-shadow:var(--sh1)}.btn:hover:not(:disabled),.rb:hover{filter:none;transform:none}}
+@media (prefers-reduced-motion:no-preference){a.k:active,button.k:active{transform:translateY(1px)}.btn:active:not(:disabled),.rb:active{transform:translateY(1px)}}
+
+/* Nút: mực tím phẳng, không gradient, không vệt sáng */
+.btn{border-radius:14px;background:var(--violet);color:#fff;box-shadow:none;padding:13px 18px;font:600 15.5px/1.25 var(--f2);letter-spacing:0}
+.btn.ghost{background:transparent;color:var(--violet);box-shadow:inset 0 0 0 1.5px var(--violet)}
+.btn:disabled{opacity:.45}
+.btn::after,.rb::after{content:none;animation:none}
+.rb{background:var(--violet);box-shadow:none;font:600 15px var(--f2)}
+.pill,.chip{background:#fff;border:1px solid var(--line2);padding:5px 13px;font:500 14px/1.35 var(--f2)}
+.pill.on,.chip[aria-pressed=true]{background:var(--violet);border-color:var(--violet);color:#fff}
+.on{background:var(--blush2)}
+.btn:focus-visible,.pill:focus-visible,.rb:focus-visible,.nav a:focus-visible,a.k:focus-visible,button.k:focus-visible,.rowl:focus-visible,.lh-link:focus-visible{outline:2.5px solid var(--violet);outline-offset:2px}
+
+/* Thanh dưới: dải giấy sát mép, một dải "bookmark" đỏ trượt trên tab đang mở */
+.nav{margin:0;padding:6px 8px max(8px,env(safe-area-inset-bottom));background:var(--cream);-webkit-backdrop-filter:none;backdrop-filter:none;border:0;border-top:1px solid var(--line2);border-radius:0;box-shadow:none}
+.nav-ind{top:-1px;bottom:auto;left:8px;width:calc((100% - 16px)/5);height:3px;border-radius:0 0 3px 3px;background:linear-gradient(90deg,transparent 32%,var(--rose) 32% 68%,transparent 68%);box-shadow:none;transition:transform .55s var(--spring),opacity .2s}
+.nav a{padding:8px 2px 6px;border-radius:10px;font:500 11px/1.2 var(--f2);color:var(--ink2)}
+.nav .a{color:var(--violet);font-weight:600}
+.nav .a svg{fill:rgba(244,184,200,.75);transform:none}
+.fab{bottom:84px}
+
+/* Bong bóng chat */
+.k.me{border-radius:14px 14px 3px 14px}.k.you{border-radius:14px 14px 14px 3px}
+.k.pk.me{background:#E9E7FA;border-color:rgba(58,51,150,.22)}
+
+/* Chi tiết nhỏ: ảnh, ghim, avatar, khóa PIN, thanh tiến độ */
+.mapbox{border-radius:14px;box-shadow:var(--sh1)}
+.pin{border:2px solid #fff;box-shadow:0 0 0 1.5px var(--violet);background:var(--lav)}.pin.on{background:var(--blush2)}
+.av{border:2px solid #fff;box-shadow:0 0 0 1.5px var(--violet);background:var(--lav)}.av.on{background:var(--blush2)}
+.grid .th,.mgrid .th{border-radius:8px}
+.strip img{border-radius:10px}
+.dots i{border-color:var(--violet)}.dots i.f{background:var(--violet);transform:none}
+.pad button{border-radius:14px;box-shadow:var(--sh1);font:600 24px var(--f1)}.pad button.sm{background:var(--blush)}
+.bar{background:#E9E8F7}.bar>i,.lv-bar>i{background:var(--violet)}
+.lv-bar{background:#E9E8F7}
+.lv-it{background:#fff;border-radius:12px;box-shadow:var(--sh1)}
+.lv-it.sel{background:#EFEEFB;border-color:var(--violet);box-shadow:0 0 0 2px rgba(58,51,150,.18)}
+.call,.sheet{background:var(--cream)}
+.rec.on{background:var(--blush)}
+
+/* Trang chủ */
+.couple-names{font:600 16px/1.2 var(--f1);letter-spacing:0;color:var(--ink2)}
+.couple-names i{color:var(--rose);margin:0 7px}
+.eyebrow,.ic{display:none}
+.hero-k{border-left:3px solid var(--rose);border-radius:4px 14px 14px 4px}
+.hero-k .big{background:none;box-shadow:none;padding:0;min-width:0}
+.hero-k .big .num{font-size:30px;color:var(--rose-d)}
+.hero-k .big span:not(.num){font:600 13px var(--f1);letter-spacing:0;text-transform:none;color:var(--ink2)}
+
+/* Danh sách lối tắt: một tờ giấy kẻ dòng, chạm vào thì bút dạ vàng quét dưới tiêu đề */
+.k.lst{background:var(--cream);border:0;border-radius:0;box-shadow:none;padding:0 4px}
+.rowl{display:flex;align-items:center;gap:12px;padding:14px 2px;border-radius:0;transition:none}
+.rowl::after{content:none}
+.rowl+.rowl::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:var(--rule);transform-origin:left}
+.rowl b{display:inline;font:600 16.5px/1.5 var(--f1);background:linear-gradient(var(--peach),var(--peach)) 0 85%/0% 55% no-repeat;transition:background-size .4s var(--ease)}
+.rowl:hover,.rowl:active{background:none}
+.rowl:active b,.rowl:focus-visible b{background-size:100% 55%}
+@media (hover:hover){.rowl:hover b{background-size:100% 55%}}
+.pulse{width:8px;height:8px;background:var(--rose)}.pulse::after{content:none}
+
+/* Tờ lịch bloc đếm ngày (components/LoveHeart.tsx) */
+.lh-link{display:block;flex:none;border-radius:10px}
+.lf{position:relative;width:100%;max-width:300px;margin:8px auto 10px;perspective:900px}
+.lf::before,.lf::after{content:'';position:absolute;left:6px;right:6px;top:0;bottom:0;background:#fff;border:1px solid var(--line2);border-radius:10px}
+.lf::before{transform:translateY(7px) rotate(1.4deg)}.lf::after{transform:translateY(3.5px) rotate(-1deg)}
+.lf-leaf{position:relative;z-index:1;background:#fff;border:1px solid var(--line2);border-radius:10px;overflow:hidden;box-shadow:var(--sh2);transform-origin:50% 0}
+.lf-top{display:flex;justify-content:space-between;min-height:34px;align-items:center;padding:0 16px;background:var(--violet);color:#fff;font:500 12.5px/1 var(--f2)}
+.lf-n{padding-top:12px;text-align:center;font:800 clamp(84px,28vw,112px)/1 var(--f2);letter-spacing:-.05em;font-variant-numeric:tabular-nums;color:var(--rose-d)}
+.lf-l{padding-bottom:20px;text-align:center;font:600 19px/1.2 var(--f1);color:var(--ink2)}
+.lf-heart{position:absolute;right:12px;bottom:10px;width:52px;height:52px;transform:rotate(-9deg)}
+.lf-eye{transform-box:fill-box;transform-origin:center}
+@media (prefers-reduced-motion:no-preference){
+  /* Khoảnh khắc duy nhất khi vào Trang chủ: tờ lịch lật xuống từ mép trên, rồi các dòng kẻ vẽ ra lần lượt */
+  .lf-leaf{animation:lfdrop 1s var(--ease) backwards;transition:transform .15s}
+  .lh-link:active .lf-leaf{transform:translateY(2px)}
+  .rowl+.rowl::before{animation:ruledraw .7s var(--ease) backwards}
+  .rowl:nth-child(2)::before{animation-delay:.7s}.rowl:nth-child(3)::before{animation-delay:.76s}.rowl:nth-child(4)::before{animation-delay:.82s}.rowl:nth-child(5)::before{animation-delay:.88s}.rowl:nth-child(6)::before{animation-delay:.94s}
+  .lf-eye{animation:lfblink 6s infinite}
+  @keyframes lfdrop{0%{transform:rotateX(-86deg);opacity:0}30%{opacity:1}72%{transform:rotateX(6deg)}100%{transform:none}}
+  @keyframes ruledraw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
+  @keyframes lfblink{0%,94%,100%{transform:scaleY(1)}97%{transform:scaleY(.1)}}
+}
+
+/* Bản đồ Kỷ niệm và Khoảnh khắc: cùng ngôn ngữ giấy phẳng, bỏ gradient hồng và bo góc quá lớn */
+.memory-hero,.moments-hero{background:#fff;border:1px solid var(--line);border-left:3px solid var(--rose);border-radius:4px 14px 14px 4px;box-shadow:var(--sh1)}
