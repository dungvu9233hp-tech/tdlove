+        </div>
+        {stats.n === 0 ? <div className="s">Chưa có ván nào xong. Chơi một ván thử nhé!</div>
+          : <div className="s">Bạn thắng {stats.all.me} · {pn} thắng {stats.all.you} · hòa hoặc cùng vui {stats.all.tie}</div>}
