+-- THAT THACH
+do $$ declare u1 uuid:='11111111-1111-1111-1111-111111111111'; u2 uuid:='22222222-2222-2222-2222-222222222222'; gid uuid; g games; failed boolean;
+begin
+  perform t_as(u1); gid:=game_create('that_thach');
