diff --git a/public/offline.html b/public/offline.html
new file mode 100644
index 0000000..446b258
--- /dev/null
+++ b/public/offline.html
@@ -0,0 +1,4 @@
+<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>tdlove</title>
+<style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#FFF0F6;color:#5B1F3A;font:700 18px system-ui,sans-serif;text-align:center;padding:24px}
+img{width:96px;height:96px}button{margin-top:16px;background:#FF8FB8;border:2.5px solid #5B1F3A;border-radius:999px;padding:11px 28px;font:800 18px system-ui;color:#5B1F3A}</style></head>
+<body><div><img src="/icons/icon-192.png" alt=""><p>Đang mất kết nối mạng.<br>Bật lại Wi-Fi hoặc 4G rồi thử lại nhé.</p><button onclick="location.reload()">Thử lại</button></div></body></html>
diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..e837aa9
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,30 @@
+// tdlove service worker: cache tài nguyên tĩnh, trang offline dự phòng, thông báo đẩy
+const V = 'tdlove-v1', SHELL = ['/offline.html', '/icons/icon-192.png']
+self.addEventListener('install', e => { e.waitUntil(caches.open(V).then(c => c.addAll(SHELL)).then(() => self.skipWaiting())) })
+self.addEventListener('activate', e => { e.waitUntil(caches.keys().then(ks => Promise.all(ks.filter(k => k !== V).map(k => caches.delete(k)))).then(() => self.clients.claim())) })
+
+self.addEventListener('fetch', e => {
+  const r = e.request, u = new URL(r.url)
+  if (r.method !== 'GET' || u.origin !== location.origin) return          // Supabase và các domain ngoài đi thẳng ra mạng
+  if (u.pathname.startsWith('/_next/static/') || u.pathname.startsWith('/icons/')) {   // file có hash: cache trước
+    e.respondWith(caches.match(r).then(h => h || fetch(r).then(n => { const c = n.clone(); caches.open(V).then(x => x.put(r, c)); return n })))
+  } else if (r.mode === 'navigate') {                                       // trang: mạng trước, mất mạng thì hiện trang offline
+    e.respondWith(fetch(r).catch(() => caches.match('/offline.html')))
+  }
+})
+
+self.addEventListener('push', e => {
+  let d = {}; try { d = e.data ? e.data.json() : {} } catch { }
+  e.waitUntil(self.registration.showNotification(d.title || 'tdlove', {
+    body: d.body || '', icon: '/icons/icon-192.png', badge: '/icons/icon-192.png', tag: d.tag || d.kind || 'tdlove', renotify: true,
+    requireInteraction: d.kind === 'call', vibrate: d.kind === 'call' ? [400, 200, 400, 200, 400] : [200, 100, 200], data: { url: d.url || '/' },
+  }))
+})
+self.addEventListener('notificationclick', e => {
+  e.notification.close()
+  const url = (e.notification.data && e.notification.data.url) || '/'
+  e.waitUntil(self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then(cs => {
+    for (const c of cs) if ('focus' in c) { c.navigate && c.navigate(url); return c.focus() }
+    return self.clients.openWindow(url)
+  }))
+})
diff --git a/supabase/functions/README.md b/supabase/functions/README.md
new file mode 100644
index 0000000..3782ec4
--- /dev/null
+++ b/supabase/functions/README.md
@@ -0,0 +1,20 @@
+# Thông báo đẩy (Web Push): CHAT-04, CALL-05, ANNIV-04
+
+Phần này **chưa được chạy thử trên Supabase thật**; làm theo từng bước và thử bằng hai máy.
+
+1. Tạo khóa VAPID (một lần): `npx web-push generate-vapid-keys`
+2. Đặt biến môi trường cho app (Vercel và `.env.local`): `NEXT_PUBLIC_VAPID_PUBLIC_KEY=<khóa công khai>`, rồi deploy lại.
+3. Đặt secret cho Edge Functions (khóa riêng không bao giờ đưa vào app):
+   `supabase secrets set VAPID_PUBLIC_KEY=<công khai> VAPID_PRIVATE_KEY=<riêng> VAPID_SUBJECT=mailto:email-cua-ban@example.com`
+4. Deploy (chạy `supabase init` và `supabase link --project-ref <ref>` nếu chưa có):
+   `supabase functions deploy push` và `supabase functions deploy anniversary`
+5. Nhắc ngày đặc biệt mỗi sáng 8h (giờ Việt Nam = 01:00 UTC). Trong SQL Editor (bật extension `pg_cron` và `pg_net` ở Database > Extensions):
+   ```sql
+   select cron.schedule('tdlove-anniversary', '0 1 * * *', $$
+     select net.http_post(
+       url := 'https://<ref>.supabase.co/functions/v1/anniversary',
+       headers := jsonb_build_object('Authorization', 'Bearer <SERVICE_ROLE_KEY>', 'Content-Type', 'application/json'),
+       body := '{}'::jsonb) $$);
+   ```
+   (Khóa service_role chỉ dán vào SQL Editor, không đưa vào mã nguồn.)
+6. Mỗi người mở **Cài đặt > Bật thông báo** trên máy của mình. iPhone: phải "Thêm vào Màn hình chính" trước, iOS 16.4 trở lên.
diff --git a/supabase/functions/anniversary/index.ts b/supabase/functions/anniversary/index.ts
new file mode 100644
index 0000000..216c68a
--- /dev/null
+++ b/supabase/functions/anniversary/index.ts
@@ -0,0 +1,40 @@
+// Edge Function `anniversary`: nhắc ngày đặc biệt (ANNIV-04). Chạy mỗi sáng bằng pg_cron (xem README.md cùng thư mục).
+// Nhắc vào ngày đó và trước một ngày: ngày đặc biệt tự thêm, kỷ niệm tròn năm, các mốc 100/200/365... ngày.
+import { createClient } from 'npm:@supabase/supabase-js@2'
+import webpush from 'npm:web-push@3.6.7'
+
+const MS = [100, 200, 300, 365, 400, 500, 600, 700, 730, 800, 900, 1000, 1500, 2000]
+const ymd = (d: Date) => d.toISOString().slice(0, 10)   // dùng UTC trên "ngày lịch" đã quy đổi sang giờ Việt Nam
+const addDays = (d: Date, n: number) => new Date(d.getTime() + n * 864e5)
+
+Deno.serve(async () => {
+  const url = Deno.env.get('SUPABASE_URL')!
+  const admin = createClient(url, Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!)
+  webpush.setVapidDetails(Deno.env.get('VAPID_SUBJECT')!, Deno.env.get('VAPID_PUBLIC_KEY')!, Deno.env.get('VAPID_PRIVATE_KEY')!)
+  const vn = new Date(Date.now() + 7 * 36e5)                // giờ Việt Nam (UTC+7)
+  const today = new Date(Date.UTC(vn.getUTCFullYear(), vn.getUTCMonth(), vn.getUTCDate()))
+  const { data: spaces } = await admin.from('spaces').select('id,start_date')
+  let sent = 0
+  for (const sp of spaces ?? []) {
+    const { data: subs } = await admin.from('push_subscriptions').select('endpoint,p256dh,auth').eq('space_id', sp.id)
+    if (!subs?.length) continue
+    const { data: sd } = await admin.from('special_dates').select('name,on_date,yearly').eq('space_id', sp.id)
+    const notes: string[] = []
+    for (const off of [0, 1]) {
+      const day = addDays(today, off), key = ymd(day), md = key.slice(5), when = off ? 'Ngày mai' : 'Hôm nay'
+      for (const s of sd ?? []) if (s.yearly ? s.on_date.slice(5) === md : s.on_date === key) notes.push(`${when}: ${s.name}`)
+      if (sp.start_date) {
+        const n = Math.round((+day - +new Date(sp.start_date + 'T00:00:00Z')) / 864e5) + 1
+        if (MS.includes(n)) notes.push(`${when}: ngày thứ ${n} bên nhau`)
+        if (sp.start_date.slice(5) === md && +day > +new Date(sp.start_date + 'T00:00:00Z')) notes.push(`${when}: kỷ niệm ${day.getUTCFullYear() - +sp.start_date.slice(0, 4)} năm yêu nhau`)
+      }
+    }
+    if (!notes.length) continue
+    const payload = JSON.stringify({ kind: 'anniv', title: 'tdlove', body: notes.join('\n'), url: '/special', tag: 'anniv' })
+    for (const s of subs) {
+      try { await webpush.sendNotification({ endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } }, payload, { TTL: 6 * 3600 }); sent++ }
+      catch (e: any) { if (e?.statusCode === 404 || e?.statusCode === 410) await admin.from('push_subscriptions').delete().eq('endpoint', s.endpoint); else console.error('anniv', e?.statusCode) }
+    }
+  }
+  return new Response(JSON.stringify({ sent }), { headers: { 'Content-Type': 'application/json' } })
+})
diff --git a/supabase/functions/push/index.ts b/supabase/functions/push/index.ts
new file mode 100644
index 0000000..71421eb
--- /dev/null
+++ b/supabase/functions/push/index.ts
@@ -0,0 +1,40 @@
+// Edge Function `push`: gửi thông báo đẩy đến máy người kia khi có tin nhắn mới hoặc cuộc gọi đến (CHAT-04, CALL-05).
+// Gọi từ app bằng supabase.functions.invoke('push', { body: { kind: 'message' | 'call', text } }).
+import { createClient } from 'npm:@supabase/supabase-js@2'
+import webpush from 'npm:web-push@3.6.7'
+
+const cors = { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type' }
+const reply = (b: unknown, status = 200) => new Response(JSON.stringify(b), { status, headers: { ...cors, 'Content-Type': 'application/json' } })
+
+Deno.serve(async req => {
+  if (req.method === 'OPTIONS') return new Response('ok', { headers: cors })
+  try {
+    const url = Deno.env.get('SUPABASE_URL')!
+    // Xác thực người gọi bằng JWT của chính họ, rồi đọc hồ sơ qua RLS để biết họ thuộc Space nào
+    const user = createClient(url, Deno.env.get('SUPABASE_ANON_KEY')!, { global: { headers: { Authorization: req.headers.get('Authorization') ?? '' } } })
+    const { data: { user: u } } = await user.auth.getUser()
+    if (!u) return reply({ error: 'unauthorized' }, 401)
+    const { data: me } = await user.from('profiles').select('space_id,display_name').eq('id', u.id).maybeSingle()
+    if (!me?.space_id) return reply({ error: 'no space' }, 403)
+    const { kind, text } = await req.json()
+    if (kind !== 'message' && kind !== 'call') return reply({ error: 'bad kind' }, 400)
+
+    webpush.setVapidDetails(Deno.env.get('VAPID_SUBJECT')!, Deno.env.get('VAPID_PUBLIC_KEY')!, Deno.env.get('VAPID_PRIVATE_KEY')!)
+    const admin = createClient(url, Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!)
+    const { data: subs } = await admin.from('push_subscriptions').select('endpoint,p256dh,auth').eq('space_id', me.space_id).neq('user_id', u.id)
+    const payload = JSON.stringify(kind === 'call'
+      ? { kind, title: me.display_name ?? 'Người ấy', body: 'Đang gọi cho bạn…', url: '/chat', tag: 'call' }
+      : { kind, title: me.display_name ?? 'Người ấy', body: String(text ?? 'Tin nhắn mới').slice(0, 120), url: '/chat', tag: 'msg' })
+    let sent = 0
+    for (const s of subs ?? []) {
+      try {
+        await webpush.sendNotification({ endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } }, payload, { TTL: kind === 'call' ? 30 : 3600, urgency: 'high' })
+        sent++
+      } catch (e: any) {
+        if (e?.statusCode === 404 || e?.statusCode === 410) await admin.from('push_subscriptions').delete().eq('endpoint', s.endpoint) // máy đã gỡ đăng ký
+        else console.error('push', e?.statusCode, e?.body)
+      }
+    }
+    return reply({ sent })
+  } catch (e) { console.error(e); return reply({ error: 'server' }, 500) }
+})
diff --git a/supabase/phase4.sql b/supabase/phase4.sql
index 4e9cc75..6b7bd97 100644
--- a/supabase/phase4.sql
+++ b/supabase/phase4.sql
@@ -15,3 +15,69 @@ declare c text; begin
   return c; end $$;
 revoke all on function renew_invite() from public, anon;
 grant execute on function renew_invite() to authenticated;
+
+-- ====== Phần 2: #6, #8, #9, #11, #12 (chạy sau phần 1, vẫn trong phase4) ======
+
+-- #6: hết giờ chia sẻ thì người kia không đọc được vị trí nữa (chủ vị trí vẫn thấy dòng của mình để tắt/gia hạn)
+drop policy if exists lo_r on locations;
+create policy lo_r on locations for select using (space_id=my_space() and (user_id=auth.uid() or share_until>now()));
+delete from locations where share_until<now();   -- dọn các dòng vị trí đã hết hạn còn sót
+
+-- #8: kênh tín hiệu cuộc gọi chuyển sang kênh private, chỉ hai người trong Space đọc/ghi được kênh call-<space id>
+drop policy if exists call_rt_read on realtime.messages;
+drop policy if exists call_rt_write on realtime.messages;
+create policy call_rt_read on realtime.messages for select to authenticated
+  using (realtime.messages.extension = 'broadcast' and (select realtime.topic()) = 'call-' || my_space()::text);
+create policy call_rt_write on realtime.messages for insert to authenticated
+  with check (realtime.messages.extension = 'broadcast' and (select realtime.topic()) = 'call-' || my_space()::text);
+
+-- #9: mã mời 12 ký tự, join_space khóa dòng Space khi kiểm tra số người, và giới hạn 5 lần nhập sai / 15 phút / tài khoản
+alter table spaces alter column invite_code set default substr(replace(gen_random_uuid()::text,'-',''),1,12);
+create or replace function renew_invite() returns text language plpgsql security definer set search_path=public as $$
+declare c text; begin
+  if my_space() is null then raise exception 'Bạn chưa ở trong Space nào'; end if;
+  if (select count(*) from profiles where space_id=my_space())>=2 then raise exception 'Space này đã đủ hai người'; end if;
+  update spaces set invite_code=substr(replace(gen_random_uuid()::text,'-',''),1,12), invite_expires=now()+interval '24 hours'
+    where id=my_space() returning invite_code into c;
+  return c; end $$;
+create table if not exists join_attempts(user_id uuid not null, at timestamptz not null default now());
+create index if not exists join_attempts_idx on join_attempts(user_id, at);
+alter table join_attempts enable row level security;   -- không có policy: chỉ hàm security definer truy cập được
+drop function if exists join_space(text, text);
+-- Trả về 'ok' hoặc câu báo lỗi (không raise, để lần nhập sai vẫn được ghi lại, vì raise sẽ hoàn tác cả giao dịch)
+create function join_space(p_code text, p_name text) returns text language plpgsql security definer set search_path=public as $$
+declare s spaces; begin
+  if auth.uid() is null then return 'Bạn cần đăng nhập'; end if;
+  if (select count(*) from join_attempts where user_id=auth.uid() and at>now()-interval '15 minutes')>=5 then
+    return 'Nhập sai mã mời quá nhiều lần, hãy thử lại sau 15 phút'; end if;
+  if exists(select 1 from profiles where id=auth.uid() and space_id is not null) then return 'Bạn đã ở trong một Space rồi'; end if;
+  select * into s from spaces where invite_code=lower(trim(p_code)) and invite_expires>now() for update;
+  if s.id is null then insert into join_attempts(user_id) values(auth.uid()); return 'Mã mời không đúng hoặc đã hết hạn'; end if;
+  if (select count(*) from profiles where space_id=s.id)>=2 then return 'Space này đã đủ hai người'; end if;
+  insert into profiles(id,space_id,display_name) values(auth.uid(),s.id,p_name)
+    on conflict(id) do update set space_id=s.id, display_name=p_name;
+  update spaces set invite_expires=now()-interval '1 second' where id=s.id;
+  delete from join_attempts where user_id=auth.uid();
+  return 'ok'; end $$;
+revoke all on function join_space(text, text) from public, anon;
+grant execute on function join_space(text, text) to authenticated;
+
+-- #11: giới hạn cột được sửa, và policy update có with check
+drop policy if exists pr_u on profiles;
+create policy pr_u on profiles for update using (id=auth.uid()) with check (id=auth.uid());
+drop policy if exists ms_u on messages;   -- chỉ người nhận được đánh dấu "đã xem", và chỉ sửa cột seen_at
+create policy ms_u on messages for update using (space_id=my_space() and sender<>auth.uid()) with check (space_id=my_space() and sender<>auth.uid());
+revoke update on messages from authenticated, anon;
+grant update (seen_at) on messages to authenticated;
+drop policy if exists di_u on diary_entries;
+create policy di_u on diary_entries for update using (author=auth.uid()) with check (author=auth.uid() and space_id=my_space());
+revoke update on diary_entries from authenticated, anon;
+grant update (entry_date, title, body, mood) on diary_entries to authenticated;
+
+-- #12: lưu đăng ký nhận thông báo đẩy (mỗi trình duyệt/máy một dòng)
+create table if not exists push_subscriptions(
+  endpoint text primary key, user_id uuid not null default auth.uid() references auth.users on delete cascade,
+  space_id uuid not null, p256dh text not null, auth text not null, created_at timestamptz default now());
+alter table push_subscriptions enable row level security;
+drop policy if exists ps_all on push_subscriptions;
+create policy ps_all on push_subscriptions for all using (user_id=auth.uid()) with check (user_id=auth.uid() and space_id=my_space());
